{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gallop:schema:session:1.0",
  "title": "Gallop Session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "session_id", "occurred_at", "tutor", "subject", "course",
    "title", "summary", "concepts", "proofs_derivations", "hard_problem_sessions",
    "oral_exams", "simulation_labs", "mistakes", "weakness_tags", "open_questions",
    "connections", "research_ideas", "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "session_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "tutor": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "course": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "concepts": {"$ref": "#/$defs/stringArray"},
    "proofs_derivations": {"type": "array", "items": {"type": "object"}},
    "hard_problem_sessions": {"type": "array", "items": {"type": "object"}},
    "oral_exams": {"type": "array", "items": {"type": "object"}},
    "simulation_labs": {"type": "array", "items": {"type": "object"}},
    "mistakes": {"type": "array", "items": {"type": "object"}},
    "weakness_tags": {"$ref": "#/$defs/stringArray"},
    "open_questions": {"type": "array", "items": {}},
    "connections": {"type": "array", "items": {}},
    "research_ideas": {"type": "array", "items": {}},
    "artifacts": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string"}}
  }
}
