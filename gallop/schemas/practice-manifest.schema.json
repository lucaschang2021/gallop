{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gallop.dev/schemas/practice-manifest.schema.json",
  "title": "Gallop Practice Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_id", "session_id", "subject", "course", "topic",
    "concepts", "weakness_tags", "mistakes", "open_questions", "difficulty",
    "practice_priority", "source_notes", "requested_question_count", "practice_modes",
    "no_agent", "hint_gradient", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "course": {"type": "string"},
    "topic": {"type": "string", "minLength": 1},
    "concepts": {"type": "array", "items": {"type": "string"}},
    "weakness_tags": {"type": "array", "items": {"type": "string"}},
    "mistakes": {"type": "array", "items": {}},
    "open_questions": {"type": "array", "items": {}},
    "difficulty": {"enum": ["introductory", "easy", "medium", "hard", "research"]},
    "practice_priority": {"type": "integer", "minimum": 1, "maximum": 5},
    "source_notes": {"type": "array", "items": {"type": "string"}},
    "requested_question_count": {"type": "integer", "minimum": 1, "maximum": 100},
    "practice_modes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "no_agent": {"type": "boolean"},
    "hint_gradient": {
      "type": "array",
      "prefixItems": [
        {"const": "independent_attempt"},
        {"const": "direction_only"},
        {"const": "key_observation"},
        {"const": "skeleton"},
        {"const": "full_solution"}
      ],
      "minItems": 5,
      "maxItems": 5
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}

