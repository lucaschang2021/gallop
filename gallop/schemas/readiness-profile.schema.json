{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Derived Readiness Profile 1.1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "subject": {
      "enum": [
        "mathematics",
        "statistics",
        "finance",
        "cs-ai"
      ]
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dimension": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "UNKNOWN",
              "FOUNDATIONAL",
              "DEVELOPING",
              "SOLID",
              "STRONG",
              "ADVANCED"
            ]
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "evidence_count": {
            "type": "integer",
            "minimum": 0
          },
          "last_updated": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "independent_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "assisted_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "benchmark_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "transfer_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "failure_modes": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "required": [
          "dimension",
          "status",
          "confidence",
          "evidence_count",
          "last_updated",
          "evidence_refs",
          "reason",
          "independent_evidence",
          "assisted_evidence",
          "benchmark_evidence",
          "transfer_evidence",
          "failure_modes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "subject",
    "dimensions"
  ],
  "additionalProperties": false
}
