{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tutor Session Package v1",
  "type": "object",
  "required": [
    "tutor",
    "title",
    "occurred_at",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "tutor": {
      "enum": [
        "mathematics",
        "statistics",
        "finance",
        "cs-ai"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "course": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*(Z|[+-]\\d{2}:\\d{2})$"
    },
    "weakness_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "concepts": {
      "type": "array"
    },
    "proofs_derivations": {
      "type": "array"
    },
    "mistakes": {
      "type": "array"
    },
    "open_questions": {
      "type": "array"
    },
    "connections": {
      "type": "array"
    },
    "research_ideas": {
      "type": "array"
    },
    "hard_problem_sessions": {
      "type": "array"
    },
    "oral_exams": {
      "type": "array"
    },
    "simulation_labs": {
      "type": "array"
    },
    "artifacts": {
      "type": "array"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "elite_evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "progressive_mentorship": {
      "type": "object",
      "properties": {
        "target_capabilities": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "target_capability": {
          "type": "object"
        },
        "current_capability": {
          "type": "object"
        },
        "training_zone": {
          "enum": [
            "FOUNDATION",
            "PRODUCTIVE",
            "STRETCH",
            "MONSTER_BENCHMARK"
          ]
        },
        "scaffolding_level": {
          "enum": [
            "S5",
            "S4",
            "S3",
            "S2",
            "S1",
            "S0"
          ]
        },
        "prerequisite_gaps": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "productive_struggle": {
          "type": "object"
        },
        "capability_gains": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "research_independence": {
          "type": "object"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "$id": "urn:gallop:schema:tutor-intake:1.0"
}
